@using Triker.Shared.Dtos
@using Triker.Shared.Models

@*
    Fila compacta por rival. Durante la partida HandSize siempre vale 5 (se
    descartan N cartas y se roban N al momento), asi que pintar cinco cartas
    boca abajo por jugador ocupaba ~180px para no decir nada: con 8 jugadores
    la mesa medía 1656px en una ventana de 873. Lo que si cambia -- turno,
    descarte, medallas -- cabe en una linea.
*@

@*
    Dos disposiciones. Como asientos (Asientos, hasta MaxAsientos rivales): arriba de
    tu zona, cada rival con su avatar, en una fila hasta 4 y en dos hasta 8. Con más
    no caben sin echar tu mano de la pantalla, y van en la lista de siempre, debajo.
    Es el mismo marcado; lo que cambia es el CSS (.other-players.asientos).
*@
@{
    var rivales = Players
        .SkipWhile(p => p.Id != MyPlayerId).Skip(1)
        .Concat(Players.TakeWhile(p => p.Id != MyPlayerId))
        .ToList();
    // Hasta 4, una fila; de 5 a 8, dos filas lo más iguales posible (5 -> 3 + 2).
    var columnas = rivales.Count <= 4 ? Math.Max(rivales.Count, 1) : (rivales.Count + 1) / 2;
}

<div class="other-players @(Asientos ? (rivales.Count <= 4 ? "asientos asientos-pocos" : "asientos asientos-muchos") : "")"
     style="@(Asientos ? $"--columnas:{columnas}" : null)">
    @foreach (var player in rivales)
    {
        // Quien salio a mitad de ronda sigue en la lista hasta revelar.
        var ready = player.TurnStatus == PlayerTurnStatus.Ready && !player.HasLeft;

        <div class="other-player @(player.IsCurrentTurn ? "active-turn" : "") @(ready ? "is-ready" : "") @(player.HasLeft ? "has-left" : "")">
            @if (Reactions != null && Reactions.TryGetValue(player.Id, out var rx))
            {
                <span class="reaction-bubble" @key="rx.Seq">@rx.Emoji</span>
            }

            @* El avatar solo se ve en los asientos. Los bots llevan un robot: ahí la
               etiqueta «Bot» no cabe, y queda solo para los lectores de pantalla. *@
            <span class="op-avatar" aria-hidden="true">
                @if (player.IsBot) { <Icono Nombre="robot" /> } else { @Inicial(player.Name) }
            </span>

            <span class="op-mark" aria-hidden="true">@(player.HasLeft ? "✕" : player.IsCurrentTurn ? "▸" : ready ? "✓" : "•")</span>

            <span class="other-player-name">@player.Name</span>

            @if (player.IsBot)
            {
                <span class="player-tag tag-bot">Bot</span>
            }

            @if (player.Wins > 0 || player.Seconds > 0 || player.Thirds > 0)
            {
                <span class="player-medals">
                    @if (player.Wins > 0)    { <span><Medalla Puesto="1" />@player.Wins</span> }
                    @if (player.Seconds > 0) { <span><Medalla Puesto="2" />@player.Seconds</span> }
                    @if (player.Thirds > 0)  { <span><Medalla Puesto="3" />@player.Thirds</span> }
                </span>
            }

            <span class="op-state">
                @if (player.HasLeft)
                {
                    <span class="left-badge" title="Salió de la mesa: su mano no cuenta en esta ronda">salió</span>
                }
                else if (player.IsCurrentTurn)
                {
                    <span class="turn-badge">su turno</span>
                }
                else if (ready)
                {
                    @if (player.DiscardCount > 0)
                    {
                        <span class="ready-badge" title="Cambió @player.DiscardCount cartas">descartó @player.DiscardCount</span>
                    }
                    else
                    {
                        <span class="ready-badge pass">pasó</span>
                    }
                }
                else
                {
                    <span class="thinking-badge" title="Todavía no le ha tocado">espera</span>
                }
            </span>
        </div>
    }
</div>

@code {
    [Parameter] public List<PlayerDto> Players { get; set; } = [];
    [Parameter] public Guid MyPlayerId { get; set; }
    [Parameter] public Dictionary<Guid, ReactionEntry>? Reactions { get; set; }
    [Parameter] public bool Asientos { get; set; }

    // Con más rivales que estos, los asientos (dos filas) ya no caben encima de tu
    // mano en un móvil de 360×740 sin sacar el botón de jugar de la pantalla.
    public const int MaxAsientos = 8;

    // La primera letra del nombre, entera aunque sea un emoji o lleve tilde.
    private static string Inicial(string nombre)
        => string.IsNullOrWhiteSpace(nombre) ? "?" : System.Globalization.StringInfo.GetNextTextElement(nombre.Trim()).ToUpperInvariant();
}
