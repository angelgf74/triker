@using Triker.Shared.Dtos
@using Triker.Shared.Models

@*
    Fila compacta por rival. Durante la partida HandSize siempre vale 5 (se
    descartan N cartas y se roban N al momento), asi que pintar cinco cartas
    boca abajo por jugador ocupaba ~180px para no decir nada: con 8 jugadores
    la mesa medi­a 1656px en una ventana de 873. Lo que si cambia -- turno,
    descarte, medallas -- cabe en una linea.
*@

<div class="other-players">
    @foreach (var player in Players
        .SkipWhile(p => p.Id != MyPlayerId).Skip(1)
        .Concat(Players.TakeWhile(p => p.Id != MyPlayerId)))
    {
        var ready = player.TurnStatus == PlayerTurnStatus.Ready;

        <div class="other-player @(player.IsCurrentTurn ? "active-turn" : "") @(ready ? "is-ready" : "")">
            @if (Reactions != null && Reactions.TryGetValue(player.Id, out var rx))
            {
                <span class="reaction-bubble" @key="rx.Seq">@rx.Emoji</span>
            }

            <span class="op-mark" aria-hidden="true">@(player.IsCurrentTurn ? "▶" : ready ? "✓" : "•")</span>

            <span class="other-player-name">@player.Name</span>

            @if (player.IsBot)
            {
                <span class="player-tag tag-bot">Bot</span>
            }

            @if (player.Wins > 0 || player.Seconds > 0 || player.Thirds > 0)
            {
                <span class="player-medals">
                    @if (player.Wins > 0)    { <span>🥇@player.Wins</span> }
                    @if (player.Seconds > 0) { <span>🥈@player.Seconds</span> }
                    @if (player.Thirds > 0)  { <span>🥉@player.Thirds</span> }
                </span>
            }

            <span class="op-state">
                @if (player.IsCurrentTurn)
                {
                    <span class="turn-badge">su turno</span>
                }
                else if (ready)
                {
                    @if (player.DiscardCount > 0)
                    {
                        <span class="ready-badge" title="Cambió @player.DiscardCount cartas">descartó @player.DiscardCount</span>
                    }
                    else
                    {
                        <span class="ready-badge pass">pasó</span>
                    }
                }
                else
                {
                    <span class="thinking-badge">pensando…</span>
                }
            </span>
        </div>
    }
</div>

@code {
    [Parameter] public List<PlayerDto> Players { get; set; } = [];
    [Parameter] public Guid MyPlayerId { get; set; }
    [Parameter] public Dictionary<Guid, ReactionEntry>? Reactions { get; set; }
}
