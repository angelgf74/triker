@if (Visible)
{
    <div class="help-overlay" @onclick="Close">
        <div class="help-modal" @onclick:stopPropagation>
            <button class="help-close" @onclick="Close">✕</button>
            <h1 class="game-title" style="text-align: center;" tabindex="-1">
                TRI<span class="mirror-k game-title">K</span>KER
            </h1>
            <h2 class="help-title">¿Cómo se juega?</h2>

            <!-- OBJETIVO -->
            <section class="help-section">
                <h3>El objetivo</h3>
                <p>Consigue la mejor mano posible con tus 5 cartas. Cuando todos los jugadores hayan
                terminado su turno, las manos se revelan y <strong>gana quien tenga la jugada más alta
                según la jerarquía</strong>. Solo hay empate si dos jugadores tienen exactamente la misma jugada.</p>
            </section>

            <!-- CARTAS -->
            <section class="help-section">
                <h3>Las cartas</h3>
                <p>Cada carta tiene <strong>3 características</strong>: letra, figura y color.
                Hay 8 valores posibles para cada una, lo que da una baraja de <strong>512 cartas únicas</strong>.</p>
                <div class="help-params">
                    <div class="help-param">
                        <span class="help-param-name">Letra</span>
                        <span class="help-param-vals">T · R · I · K · E · A · G · F</span>
                    </div>
                    <div class="help-param">
                        <span class="help-param-name">Figura</span>
                        <span class="help-param-vals help-figures">● ■ ★ ▲ ♥ ♣ ♦ ♠</span>
                    </div>
                    <div class="help-param">
                        <span class="help-param-name">Color</span>
                        <span class="help-param-vals">
                            <span style="color:#e53935">■</span> Rojo &nbsp;
                            <span style="color:#43A047">■</span> Verde &nbsp;
                            <span style="color:#1E88E5">■</span> Azul &nbsp;
                            <span style="color:#00ACC1">■</span> Cyan &nbsp;
                            <span style="color:#9C27B0">■</span> Magenta &nbsp;
                            <span style="color:#212121">■</span> Negro &nbsp;
                            <span style="color:#F57C00">■</span> Naranja &nbsp;
                            <span style="color:#795548">■</span> Marrón
                        </span>
                    </div>
                </div>
            </section>

            <!-- MECÁNICA -->
            <section class="help-section">
                <h3>Tu turno</h3>
                <ol class="help-steps">
                    <li>Al empezar recibes <strong>5 cartas</strong>.</li>
                    <li>Cuando sea tu turno, selecciona las cartas que no te interesen y pulsa <em>Descartar</em>. Recibirás al momento el mismo número de cartas nuevas.</li>
                    <li>Si estás contento con tu mano, pulsa <em>Descartar</em> sin seleccionar nada para pasar.</li>
                    <li>Una vez que todos hayan pasado, las manos se revelan y el juego calcula la puntuación automáticamente.</li>
                </ol>
            </section>

            <!-- JUGADAS -->
            <section class="help-section">
                <h3>Las jugadas</h3>
                <p>Una jugada es un grupo de <strong>2 o más cartas que comparten alguna característica</strong>
                (letra, figura o color). Puedes combinar varias jugadas a la vez siempre que no usen las mismas cartas —
                el juego elige automáticamente la combinación de mayor puntuación.</p>
                <p class="help-note">Débil = comparten 1 característica &nbsp;·&nbsp; Fuerte = comparten 2 características</p>

                <div class="help-table-wrap">
                    <table class="help-table help-hands-table">
                        <thead>
                            <tr><th>#</th><th>Jugada</th><th>Descripción</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>1</td><td>Retriker Fuerte</td><td>Las 5 cartas comparten 2 características</td></tr>
                            <tr><td>2</td><td>Triker Fuerte</td><td>4 cartas comparten 2 características</td></tr>
                            <tr><td>3</td><td>Retriker</td><td>Las 5 cartas comparten 1 característica</td></tr>
                            <tr><td>4</td><td>Full Fuerte</td><td>Trío Fuerte y Pareja Fuerte</td></tr>
                            <tr><td>5</td><td>Triker</td><td>4 cartas comparten 1 característica</td></tr>
                            <tr><td>6</td><td>Full Mixto 1</td><td>Trío Fuerte y Pareja</td></tr>
                            <tr><td>7</td><td>Trío Fuerte</td><td>3 cartas comparten 2 características</td></tr>
                            <tr><td>8</td><td>Full Mixto 2</td><td>Trío y Pareja Fuerte</td></tr>
                            <tr><td>9</td><td>Full</td><td>Trío y Pareja</td></tr>
                            <tr><td>10</td><td>Trío</td><td>3 cartas comparten 1 característica</td></tr>
                            <tr><td>11</td><td>Doble Pareja Fuerte</td><td>Dos Parejas Fuertes</td></tr>
                            <tr><td>12</td><td>Doble Pareja Mixta</td><td>Pareja Fuerte y Pareja</td></tr>
                            <tr><td>13</td><td>Pareja Fuerte</td><td>2 cartas comparten 2 características</td></tr>
                            <tr><td>14</td><td>Doble Pareja</td><td>Dos Parejas</td></tr>
                            <tr><td>15</td><td>Pareja</td><td>2 cartas comparten 1 característica</td></tr>
                            <tr class="row-special"><td>16</td><td>Sin jugada</td><td>Ninguna carta comparte característica con otra</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- EJEMPLOS VISUALES -->
            <section class="help-section">
                <h3>Ejemplos visuales</h3>

                <div class="help-examples-row">

                    <div class="help-example">
                        <div class="help-mini-hand">
                            <div class="help-mini-card color-red"><span class="hmc-lt">T</span><span class="hmc-fig">■</span></div>
                            <div class="help-mini-card color-red"><span class="hmc-lt">T</span><span class="hmc-fig">♥</span></div>
                        </div>
                        <span class="help-ex-label">Pareja Fuerte</span>
                        <span class="help-ex-desc">Letra T + Color Rojo</span>
                    </div>

                    <div class="help-example">
                        <div class="help-mini-hand">
                            <div class="help-mini-card color-red"><span class="hmc-lt">T</span><span class="hmc-fig">■</span></div>
                            <div class="help-mini-card color-green"><span class="hmc-lt">T</span><span class="hmc-fig">♥</span></div>
                        </div>
                        <span class="help-ex-label">Pareja</span>
                        <span class="help-ex-desc">Solo Letra T</span>
                    </div>

                    <div class="help-example">
                        <div class="help-mini-hand">
                            <div class="help-mini-card color-red"><span class="hmc-lt">T</span><span class="hmc-fig">■</span></div>
                            <div class="help-mini-card color-red"><span class="hmc-lt">T</span><span class="hmc-fig">♥</span></div>
                            <span class="help-ex-plus">+</span>
                            <div class="help-mini-card color-cyan"><span class="hmc-lt">I</span><span class="hmc-fig">★</span></div>
                            <div class="help-mini-card color-cyan"><span class="hmc-lt">E</span><span class="hmc-fig">●</span></div>
                            <div class="help-mini-card color-cyan"><span class="hmc-lt">T</span><span class="hmc-fig">▲</span></div>
                        </div>
                        <span class="help-ex-label">Full Mixto 2</span>
                        <span class="help-ex-desc">Pareja Fuerte + Trío Débil</span>
                    </div>

                    <div class="help-example">
                        <div class="help-mini-hand">
                            <div class="help-mini-card color-red"><span class="hmc-lt">T</span><span class="hmc-fig">■</span></div>
                            <div class="help-mini-card color-green"><span class="hmc-lt">R</span><span class="hmc-fig">♥</span></div>
                            <div class="help-mini-card color-blue"><span class="hmc-lt">I</span><span class="hmc-fig">●</span></div>
                            <div class="help-mini-card color-cyan"><span class="hmc-lt">K</span><span class="hmc-fig">▲</span></div>
                            <div class="help-mini-card color-magenta"><span class="hmc-lt">E</span><span class="hmc-fig">★</span></div>
                        </div>
                        <span class="help-ex-label">Sin jugada</span>
                        <span class="help-ex-desc">Ninguna carta comparte característica con otra</span>
                    </div>

                </div>
            </section>

        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Task Close() => OnClose.InvokeAsync();
}
