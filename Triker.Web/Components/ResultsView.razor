@using Triker.Shared.Dtos
@inject ShareService ShareSvc
@inject IJSRuntime JS

<div class="results-view">
    @if (GameOver)
    {
        var champ = Players.OrderByDescending(p => p.Wins).First();
        <div class="champion-banner">
            <span class="champion-icon">🏆</span>
            <span class="champion-name">@champ.Name</span>
            <span class="champion-sub">¡Campeón con @champ.Wins victorias en @RoundNumber rondas!</span>
        </div>
    }

    <div class="results-header">
        <h2>Resultados — @GameName</h2>
        <p class="round-label">Ronda @RoundNumber@(TargetWins > 0 && !GameOver ? $" · Meta: {TargetWins}🥇" : "")</p>
        <p class="scale-hint">
            Gana la jugada más alta, no los puntos. El número junto a cada jugada es su puesto
            en la escala de @HandLadder.Total: <strong>1 es la mejor</strong>.
        </p>
    </div>

    @*
        Resumen inmediato. Con 8 jugadores la pantalla mide ~1900px (unas 2,2
        pantallas de movil) y tu entrada cae hacia la mitad: habia que bajar
        mas de una pantalla solo para saber como te habia ido. Aqui caben las
        dos preguntas del jugador -- que hice yo y quien gano -- sin tocar el
        scroll. Las cartas siguen abajo, en la lista ordenada por posicion.
    *@
    @{
        var mine = Results.FirstOrDefault(r => r.PlayerId == MyPlayerId);
        var winner = Results.OrderBy(r => r.Rank).FirstOrDefault();
    }
    @if (mine != null || winner != null)
    {
        <div class="round-summary">
            @if (mine != null)
            {
                <div class="rs-mine">
                    @* Fuera del podio MedalLabel ya devuelve "8º": pintarlo
                       junto a la posicion daba "8º 8º de 8". *@
                    @if (Position(mine) <= 3)
                    {
                        <span class="rs-medal">@MedalLabel(mine)</span>
                    }
                    <span class="rs-position">@PositionLabel(mine) de @Results.Count</span>
                    <span class="rs-play">
                        @mine.HandName
                        <span class="grp-ladder" title="@HandLadder.Label(mine.HandRank)">
                            @HandLadder.Position(mine.HandRank)/@HandLadder.Total
                        </span>
                    </span>
                    <span class="rs-score">@mine.TotalScore pts</span>
                </div>
            }
            @if (winner != null)
            {
                <div class="rs-winner">
                    @if (mine != null && winner.PlayerId == MyPlayerId)
                    {
                        <span>🎉 Ganaste la ronda</span>
                    }
                    else
                    {
                        <span>Ganó <strong>@WinnerNames()</strong> con @winner.HandName</span>
                    }
                </div>
            }
        </div>
    }

    @* Justo debajo del resumen: cuando llega aqui el jugador ya sabe como le
       ha ido, que era el motivo de no preguntarlo antes, y decide sin bajar
       hasta el final de la lista de manos. *@
    <div class="continue-section">
        @if (IsSpectator)
        {
            @if (GameOver)
            {
                <p class="continue-prompt">La partida ha terminado.</p>
            }
            else
            {
                <p class="waiting-others">
                    Esperando a los jugadores…
                    (@Players.Count(p => p.WantsToContinue) / @Players.Count quieren continuar)
                </p>
            }
            <button class="btn-secondary" @onclick="() => Decide(false)">Dejar de ver</button>
        }
        else if (GameOver)
        {
            <p class="continue-prompt">La partida ha terminado.</p>
            <button class="btn-primary" @onclick="() => Decide(false)">Ir a sala de espera</button>
        }
        else if (!_decided)
        {
            <p class="continue-prompt">¿Quieres jugar otra partida?</p>
            <div class="continue-buttons">
                <button class="btn-primary" @onclick="() => Decide(true)">Próxima partida</button>
                <button class="btn-secondary" @onclick="() => Decide(false)">Abandonar mesa</button>
            </div>
        }
        else
        {
            <p class="waiting-others">
                Esperando a los demás jugadores…
                (@Players.Count(p => p.WantsToContinue) / @Players.Count quieren continuar)
            </p>
        }
    </div>

    @if (RoundNumber > 1)
    {
        <div class="session-stats">
            <h3 class="session-stats-title">Sesión — @RoundNumber rondas</h3>
            <div class="stats-table-wrap">
            <table class="stats-table">
                <thead>
                    <tr>
                        <th>Jugador</th>
                        <th>🥇</th>
                        <th>🥈</th>
                        <th>🥉</th>
                        <th>% Vic.</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Players
                        .OrderByDescending(p => p.Wins)
                        .ThenByDescending(p => p.Seconds)
                        .ThenByDescending(p => p.Thirds))
                    {
                        var winPct = p.Wins * 100 / RoundNumber;
                        <tr class="@(p.Id == MyPlayerId ? "stats-me" : "")">
                            <td>@p.Name@(p.Id == MyPlayerId ? " (tú)" : "")</td>
                            <td>@p.Wins</td>
                            <td>@p.Seconds</td>
                            <td>@p.Thirds</td>
                            <td>@winPct%</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }

    <div class="results-list">
        @foreach (var result in Results.OrderBy(r => r.Rank))
        {
            // Map cardId → group index (only groups with 2+ cards)
            var cardGroup = new Dictionary<Guid, int>();
            for (int gi = 0; gi < result.Groups.Count; gi++)
                if (result.Groups[gi].Cards.Count >= 2)
                    foreach (var c in result.Groups[gi].Cards)
                        cardGroup[c.Id] = gi;

            // Sort: grouped cards first (by group index), ungrouped last
            var sortedHand = result.Hand
                .OrderBy(c => cardGroup.TryGetValue(c.Id, out var g) ? g : 999)
                .ToList();

            <div class="result-entry @(result.PlayerId == MyPlayerId ? "my-result" : "") rank-@result.Rank">

                <div class="result-player-header">
                    <span class="rank-medal">@MedalLabel(result)</span>
                    <span class="result-player-name">
                        @result.PlayerName@(result.PlayerId == MyPlayerId ? " (tú)" : "")
                    </span>
                    @{ var pd = Players.FirstOrDefault(p => p.Id == result.PlayerId); }
                    @if (pd != null && (pd.Wins > 0 || pd.Seconds > 0 || pd.Thirds > 0))
                    {
                        <span class="player-medals">
                            @if (pd.Wins > 0)    { <span>🥇@pd.Wins</span> }
                            @if (pd.Seconds > 0) { <span>🥈@pd.Seconds</span> }
                            @if (pd.Thirds > 0)  { <span>🥉@pd.Thirds</span> }
                        </span>
                    }
                    @if (pd != null)
                    {
                        @* "−2" se leia como una penalizacion de puntos; son
                           cartas cambiadas. Mismo vocabulario que la mesa. *@
                        <span class="discard-badge-result" title="Cartas descartadas esta ronda">
                            @(pd.DiscardCount == 0 ? "pasó" : $"descartó {pd.DiscardCount}")
                        </span>
                    }
                </div>

                <div class="result-cards-row">
                    @foreach (var card in sortedHand)
                    {
                        var inGroup = cardGroup.TryGetValue(card.Id, out var gi);
                        var color = inGroup ? GroupColors[gi % GroupColors.Length] : null;
                        <div class="rc-slot @(inGroup ? "rc-grouped" : "")"
                             style="@(color != null ? $"--gc:{color}" : "")">
                            <CardView Card="card" FaceDown="false" />
                        </div>
                    }
                </div>

                <PlayBadge Result="result" />

                @if (result.PlayerId == MyPlayerId)
                {
                    <button class="btn-share" title="Compartir jugada" @onclick="() => ShareResult(result)">
                        📤 Compartir
                    </button>
                    @if (_shareNotice != null)
                    {
                        <span class="share-notice">@_shareNotice</span>
                    }
                }

            </div>
        }
    </div>

</div>

@code {
    private static readonly string[] GroupColors =
        ["#3b82f6", "#f59e0b", "#a855f7", "#22c55e", "#ef4444", "#06b6d4", "#ec4899"];

    [Parameter] public List<HandResultDto> Results { get; set; } = [];
    [Parameter] public List<PlayerDto> Players { get; set; } = [];
    [Parameter] public string GameName { get; set; } = "";
    [Parameter] public int RoundNumber { get; set; }
    [Parameter] public Guid MyPlayerId { get; set; }
    [Parameter] public EventCallback<bool> OnContinue { get; set; }
    [Parameter] public int TargetWins { get; set; }
    [Parameter] public bool GameOver { get; set; }
    [Parameter] public bool IsSpectator { get; set; }

    private bool _decided = false;
    private string? _shareNotice;

    private async Task Decide(bool wantsToContinue)
    {
        _decided = true;
        await OnContinue.InvokeAsync(wantsToContinue);
    }

    private async Task ShareResult(HandResultDto result)
    {
        var text = $"🎴 ¡Conseguí \"{result.HandName}\" jugando a Triker! ({result.TotalScore} pts)\n" +
                    "👉 App web: https://triker-app.angelgf.com.es/\n" +
                    "👉 Android: https://play.google.com/store/apps/details?id=com.angelgf.triker";

        string? image = null;
        try { image = await RenderHandImage(result); }
        catch { /* si falla el canvas, se comparte solo el texto */ }

        var outcome = await ShareSvc.Share(text, image);
        _shareNotice = outcome switch
        {
            "copied" => "¡Copiado al portapapeles!",
            "copied+downloaded" => "¡Copiado! Imagen descargada.",
            "unsupported" or "error" => "No se pudo compartir",
            _ => null,
        };
        StateHasChanged();

        if (_shareNotice != null)
        {
            await Task.Delay(2500);
            _shareNotice = null;
            StateHasChanged();
        }
    }

    // Genera un PNG (data URL) con las cartas de la jugada, coloreando los
    // grupos igual que en la tabla de resultados (ver ResultsView markup).
    private async Task<string> RenderHandImage(HandResultDto result)
    {
        var cardGroup = new Dictionary<Guid, int>();
        for (int gi = 0; gi < result.Groups.Count; gi++)
            if (result.Groups[gi].Cards.Count >= 2)
                foreach (var c in result.Groups[gi].Cards)
                    cardGroup[c.Id] = gi;

        var cards = result.Hand
            .OrderBy(c => cardGroup.TryGetValue(c.Id, out var g) ? g : 999)
            .Select(c => new
            {
                letter = c.Letter.ToString(),
                figure = CardVisuals.FigureSymbol(c.Figure),
                color = CardVisuals.ColorHex(c.Color),
                groupColor = cardGroup.TryGetValue(c.Id, out var gi) ? GroupColors[gi % GroupColors.Length] : null
            })
            .ToList();

        return await JS.InvokeAsync<string>("TrikerHandImage.render", cards, result.HandName, result.TotalScore, result.PlayerName);
    }

    private int Position(HandResultDto result)
        => Results.Count(r => r.HandRank > result.HandRank) + 1;

    private string MedalLabel(HandResultDto result) => Position(result) switch
    {
        1 => "🥇",
        2 => "🥈",
        3 => "🥉",
        var n => $"{n}º"
    };

    private string PositionLabel(HandResultDto result) => $"{Position(result)}º";

    // Puede haber empate arriba: se nombran todos los que comparten la mejor
    // jugada, que es lo que decide la ronda (HandRank, no los puntos).
    private string WinnerNames()
    {
        var best = Results.Max(r => r.HandRank);
        var names = Results.Where(r => r.HandRank == best).Select(r => r.PlayerName).ToList();
        return names.Count == 1 ? names[0] : string.Join(" y ", names);
    }
}
