@using Triker.Shared.Dtos

<div class="results-view">
    @if (GameOver)
    {
        var champ = Players.OrderByDescending(p => p.Wins).First();
        <div class="champion-banner">
            <span class="champion-icon">🏆</span>
            <span class="champion-name">@champ.Name</span>
            <span class="champion-sub">¡Campeón con @champ.Wins victorias en @RoundNumber rondas!</span>
        </div>
    }

    <div class="results-header">
        <h2>Resultados — @GameName</h2>
        <p class="round-label">Ronda @RoundNumber@(TargetWins > 0 && !GameOver ? $" · Meta: {TargetWins}🥇" : "")</p>
    </div>

    @if (RoundNumber > 1)
    {
        <div class="session-stats">
            <h3 class="session-stats-title">Sesión — @RoundNumber rondas</h3>
            <div class="stats-table-wrap">
            <table class="stats-table">
                <thead>
                    <tr>
                        <th>Jugador</th>
                        <th>🥇</th>
                        <th>🥈</th>
                        <th>🥉</th>
                        <th>% Vic.</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Players
                        .OrderByDescending(p => p.Wins)
                        .ThenByDescending(p => p.Seconds)
                        .ThenByDescending(p => p.Thirds))
                    {
                        var winPct = p.Wins * 100 / RoundNumber;
                        <tr class="@(p.Id == MyPlayerId ? "stats-me" : "")">
                            <td>@p.Name@(p.Id == MyPlayerId ? " (tú)" : "")</td>
                            <td>@p.Wins</td>
                            <td>@p.Seconds</td>
                            <td>@p.Thirds</td>
                            <td>@winPct%</td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    }

    <div class="continue-section">
        @if (IsSpectator)
        {
            @if (GameOver)
            {
                <p class="continue-prompt">La partida ha terminado.</p>
            }
            else
            {
                <p class="waiting-others">
                    Esperando a los jugadores…
                    (@Players.Count(p => p.WantsToContinue) / @Players.Count quieren continuar)
                </p>
            }
            <button class="btn-secondary" @onclick="() => Decide(false)">Dejar de ver</button>
        }
        else if (GameOver)
        {
            <p class="continue-prompt">La partida ha terminado.</p>
            <button class="btn-primary" @onclick="() => Decide(false)">Ir a sala de espera</button>
        }
        else if (!_decided)
        {
            <p class="continue-prompt">¿Quieres jugar otra partida?</p>
            <div class="continue-buttons">
                <button class="btn-primary" @onclick="() => Decide(true)">Próxima partida</button>
                <button class="btn-secondary" @onclick="() => Decide(false)">Abandonar mesa</button>
            </div>
        }
        else
        {
            <p class="waiting-others">
                Esperando a los demás jugadores…
                (@Players.Count(p => p.WantsToContinue) / @Players.Count quieren continuar)
            </p>
        }
    </div>

    <div class="results-list">
        @foreach (var result in Results.OrderBy(r => r.Rank))
        {
            // Map cardId → group index (only groups with 2+ cards)
            var cardGroup = new Dictionary<Guid, int>();
            for (int gi = 0; gi < result.Groups.Count; gi++)
                if (result.Groups[gi].Cards.Count >= 2)
                    foreach (var c in result.Groups[gi].Cards)
                        cardGroup[c.Id] = gi;

            // Sort: grouped cards first (by group index), ungrouped last
            var sortedHand = result.Hand
                .OrderBy(c => cardGroup.TryGetValue(c.Id, out var g) ? g : 999)
                .ToList();

            var realGroups = result.Groups.Where(g => g.Cards.Count >= 2).ToList();

            <div class="result-entry @(result.PlayerId == MyPlayerId ? "my-result" : "") rank-@result.Rank">

                <div class="result-player-header">
                    <span class="rank-medal">@MedalLabel(result)</span>
                    <span class="result-player-name">
                        @result.PlayerName@(result.PlayerId == MyPlayerId ? " (tú)" : "")
                    </span>
                    @{ var pd = Players.FirstOrDefault(p => p.Id == result.PlayerId); }
                    @if (pd != null && (pd.Wins > 0 || pd.Seconds > 0 || pd.Thirds > 0))
                    {
                        <span class="player-medals">
                            @if (pd.Wins > 0)    { <span>🥇@pd.Wins</span> }
                            @if (pd.Seconds > 0) { <span>🥈@pd.Seconds</span> }
                            @if (pd.Thirds > 0)  { <span>🥉@pd.Thirds</span> }
                        </span>
                    }
                    @if (pd != null)
                    {
                        <span class="discard-badge-result" title="Cartas descartadas esta ronda">
                            @(pd.DiscardCount == 0 ? "pasó" : $"−{pd.DiscardCount}")
                        </span>
                    }
                </div>

                <div class="result-cards-row">
                    @foreach (var card in sortedHand)
                    {
                        var inGroup = cardGroup.TryGetValue(card.Id, out var gi);
                        var color = inGroup ? GroupColors[gi % GroupColors.Length] : null;
                        <div class="rc-slot @(inGroup ? "rc-grouped" : "")"
                             style="@(color != null ? $"--gc:{color}" : "")">
                            <CardView Card="card" FaceDown="false" />
                        </div>
                    }
                </div>

                <div class="result-badges">
                    @if (realGroups.Count > 1)
                    {
                        @for (int gi = 0; gi < realGroups.Count; gi++)
                        {
                            if (gi > 0) { <span class="grp-sep">+</span> }
                            <span class="grp-badge" style="--gc:@GroupColors[gi % GroupColors.Length]">@realGroups[gi].Name</span>
                        }
                        <span class="grp-sep">→</span>
                        <span class="grp-badge grp-hand-name">@result.HandName</span>
                    }
                    else if (realGroups.Count == 1)
                    {
                        var grp = realGroups[0];
                        <span class="grp-badge" style="--gc:@GroupColors[0]">@grp.Name</span>
                    }
                    else
                    {
                        <span class="grp-badge grp-escalera">@result.HandName</span>
                    }
                </div>

            </div>
        }
    </div>
</div>

@code {
    private static readonly string[] GroupColors =
        ["#3b82f6", "#f59e0b", "#a855f7", "#22c55e", "#ef4444", "#06b6d4", "#ec4899"];

    [Parameter] public List<HandResultDto> Results { get; set; } = [];
    [Parameter] public List<PlayerDto> Players { get; set; } = [];
    [Parameter] public string GameName { get; set; } = "";
    [Parameter] public int RoundNumber { get; set; }
    [Parameter] public Guid MyPlayerId { get; set; }
    [Parameter] public EventCallback<bool> OnContinue { get; set; }
    [Parameter] public int TargetWins { get; set; }
    [Parameter] public bool GameOver { get; set; }
    [Parameter] public bool IsSpectator { get; set; }

    private bool _decided = false;

    private async Task Decide(bool wantsToContinue)
    {
        _decided = true;
        await OnContinue.InvokeAsync(wantsToContinue);
    }

    private string MedalLabel(HandResultDto result)
    {
        // Número de jugadores con puntuación estrictamente mayor
        int above = Results.Count(r => r.HandRank > result.HandRank);
        return (above + 1) switch
        {
            1 => "🥇",
            2 => "🥈",
            3 => "🥉",
            var n => $"{n}º"
        };
    }
}
