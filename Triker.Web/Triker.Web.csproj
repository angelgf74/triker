<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Triker.Shared\Triker.Shared.csproj" />
  </ItemGroup>


  <!--
    PostPublish: copia archivos CSS con nombre fingerprinted y actualiza index.html.
    Necesario para hosting estatico (nginx/IIS sin middleware ASP.NET Core) porque
    OverrideHtmlAssetPlaceholders solo funciona en el modelo hosted (con middleware).
  -->
  <Target Name="FingerprintCssForStaticHosting" AfterTargets="Publish">
    <Exec Command="powershell.exe -NonInteractive -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\PostPublish.ps1&quot; -PublishDir &quot;$(PublishDir.TrimEnd('\'))&quot;" />
  </Target>

</Project>
