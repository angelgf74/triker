@page "/"
@inject ApiService Api
@inject SessionService Session
@inject NavigationManager Nav
@inject IConfiguration Config
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json.Serialization
@implements IAsyncDisposable

<HelpModal Visible="_helpVisible" OnClose="@(() => _helpVisible = false)" />
<SugerenciasModal Visible="_sugVisible" OnClose="@(() => _sugVisible = false)" />

<div class="lobby">
    <div class="lobby-header">
        <div class="lobby-title-row">
            <button class="btn-sug" @onclick="@(() => _sugVisible = true)" title="Enviar sugerencia">✉</button>
            <h1 class="game-title">TRI<span class="mirror-k game-title">K</span>KER</h1>
            <button class="btn-help" @onclick="@(() => _helpVisible = true)" title="Ayuda">?</button>
        </div>
        <p class="game-subtitle">El juego de cartas</p>
    </div>

    <div class="player-name-section">
        <label>Tu nombre:</label>
        <input class="name-input" value="@_playerName" @oninput="OnNameInput"
               placeholder="Introduce tu nombre..." maxlength="20" />
    </div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="error-msg">@_error</div>
    }

    <div class="lobby-actions">
        <button class="btn-primary" @onclick="ShowCreateForm" disabled="@(string.IsNullOrWhiteSpace(_playerName))">
            + Nueva partida
        </button>
    </div>

    @if (_showCreateForm)
    {
        <div class="create-form">
            <input class="name-input" @bind="_gameName" placeholder="Nombre de la partida..." maxlength="30" />
            <div class="create-form-row">
                <label class="create-form-label">Meta</label>
                <select class="create-form-select" @bind="_targetWins">
                    <option value="0">Sin límite</option>
                    <option value="3">3 victorias</option>
                    <option value="5">5 victorias</option>
                    <option value="7">7 victorias</option>
                    <option value="10">10 victorias</option>
                </select>
            </div>
            <label class="private-toggle">
                <input type="checkbox" @bind="_isPrivate" />
                <span>🔒 Partida privada (con código)</span>
            </label>
            <button class="btn-primary" @onclick="CreateGame">Crear</button>
            <button class="btn-secondary" @onclick="() => _showCreateForm = false">Cancelar</button>
        </div>
    }

    <div class="games-section">
        <div class="section-header">
            <h2>Partidas disponibles</h2>
            <button class="btn-refresh" @onclick="LoadGames" title="Actualizar">↻</button>
        </div>

        @if (_loading)
        {
            <div class="loading">Cargando partidas...</div>
        }
        else if (_games.Count == 0)
        {
            <div class="empty-list">No hay partidas disponibles. ¡Crea una!</div>
        }
        else
        {
            <div class="games-list">
                @foreach (var game in _games)
                {
                    <div class="game-card">
                        <div class="game-info">
                            <span class="game-name">@(game.IsPrivate ? "🔒 " : "")@game.Name</span>
                            <span class="game-creator">por @game.CreatorName</span>
                        </div>
                        <div class="game-meta">
                            <span class="player-count">@game.PlayerCount / @game.MaxPlayers jugadores</span>
                            <span class="game-status @game.Status.ToString().ToLower()">@StatusLabel(game.Status)</span>
                        </div>
                        @if (_joiningGameId == game.Id && game.IsPrivate)
                        {
                            <div class="join-code-row">
                                <input class="name-input" @bind="_joinCode" placeholder="Código (4 dígitos)" maxlength="4" />
                                @if (game.Status == Triker.Shared.Models.GameStatus.Waiting)
                                {
                                    <button class="btn-join" @onclick="() => JoinGame(game.Id, true)"
                                            disabled="@(string.IsNullOrWhiteSpace(_playerName) || string.IsNullOrWhiteSpace(_joinCode))">
                                        Entrar
                                    </button>
                                }
                                <button class="btn-spectate" @onclick="() => Spectate(game.Id, true)"
                                        disabled="@(string.IsNullOrWhiteSpace(_playerName) || string.IsNullOrWhiteSpace(_joinCode))">
                                    👁 Ver
                                </button>
                                <button class="btn-secondary" @onclick="() => { _joiningGameId = null; _joinCode = string.Empty; }">Cancelar</button>
                            </div>
                        }
                        else
                        {
                            <div class="game-actions">
                                @if (game.Status == Triker.Shared.Models.GameStatus.Waiting)
                                {
                                    <button class="btn-join" @onclick="() => JoinGame(game.Id)"
                                            disabled="@(string.IsNullOrWhiteSpace(_playerName))">
                                        @(game.IsPrivate ? "🔒 Unirse" : "Unirse")
                                    </button>
                                }
                                @if (game.Status == Triker.Shared.Models.GameStatus.Waiting || game.Status == Triker.Shared.Models.GameStatus.Playing)
                                {
                                    <button class="btn-spectate" @onclick="() => Spectate(game.Id)"
                                            disabled="@(string.IsNullOrWhiteSpace(_playerName))">
                                        👁 Ver
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private string _playerName = "";
    private string _gameName = "";
    private int _targetWins = 0;
    private bool _isPrivate = false;
    private string _error = "";
    private bool _loading = true;
    private bool _showCreateForm = false;
    private bool _helpVisible = false;
    private bool _sugVisible = false;
    private Guid? _joiningGameId = null;
    private string _joinCode = "";
    private List<Triker.Shared.Dtos.GameSummaryDto> _games = [];
    private HubConnection? _hubConnection;

    protected override async Task OnInitializedAsync()
    {
        _playerName = await Session.GetPlayerName() ?? "";
        await LoadGames();

        var apiBase = (Config["ApiBaseUrl"] ?? "https://localhost:7077").TrimEnd('/');
        _hubConnection = new HubConnectionBuilder()
            .WithUrl($"{apiBase}/gamehub")
            .WithAutomaticReconnect()
            .AddJsonProtocol(o => o.PayloadSerializerOptions.Converters.Add(new JsonStringEnumConverter()))
            .Build();

        _hubConnection.On<List<GameSummaryDto>>("GamesUpdated", games =>
        {
            _games = games;
            _loading = false;
            InvokeAsync(StateHasChanged);
        });

        await _hubConnection.StartAsync();
    }

    private async Task OnNameInput(ChangeEventArgs e)
    {
        _playerName = e.Value?.ToString() ?? "";
        if (_playerName.Length > 0)
            await Session.SetPlayerName(_playerName);
    }

    private async Task LoadGames()
    {
        _loading = true;
        try { _games = await Api.ListGames() ?? []; }
        catch { _games = []; }
        _loading = false;
        StateHasChanged();
    }

    private void ShowCreateForm()
    {
        _gameName = $"Partida de {_playerName}";
        _showCreateForm = true;
    }

    private async Task CreateGame()
    {
        if (string.IsNullOrWhiteSpace(_playerName) || string.IsNullOrWhiteSpace(_gameName)) return;
        _error = "";
        await Session.SetPlayerName(_playerName);
        var result = await Api.CreateGame(new() { PlayerName = _playerName, GameName = _gameName, TargetWins = _targetWins, IsPrivate = _isPrivate });
        if (result != null)
            Nav.NavigateTo($"game/{result.GameState.Id}?playerId={result.PlayerId}");
        else
            _error = "No se pudo crear la partida";
    }

    private async Task JoinGame(Guid gameId, bool withCode = false)
    {
        if (string.IsNullOrWhiteSpace(_playerName)) return;
        var target = _games.FirstOrDefault(g => g.Id == gameId);
        if (target == null) return;

        // Si es privada y aún no estamos en modo "ingresar código", solo abrir el input
        if (target.IsPrivate && !withCode)
        {
            _joiningGameId = gameId;
            _joinCode = "";
            _error = "";
            return;
        }

        _error = "";
        await Session.SetPlayerName(_playerName);
        var (response, error) = await Api.JoinGame(gameId, new()
        {
            PlayerName = _playerName,
            AccessCode = target.IsPrivate ? _joinCode : null
        });
        if (response != null)
            Nav.NavigateTo($"game/{response.GameState.Id}?playerId={response.PlayerId}");
        else
            _error = error ?? "No se pudo unir a la partida";
    }

    private async Task Spectate(Guid gameId, bool withCode = false)
    {
        if (string.IsNullOrWhiteSpace(_playerName)) return;
        var target = _games.FirstOrDefault(g => g.Id == gameId);
        if (target == null) return;

        if (target.IsPrivate && !withCode)
        {
            _joiningGameId = gameId;
            _joinCode = "";
            _error = "";
            return;
        }

        _error = "";
        await Session.SetPlayerName(_playerName);
        var (response, error) = await Api.Spectate(gameId, new()
        {
            PlayerName = _playerName,
            AccessCode = target.IsPrivate ? _joinCode : null
        });
        if (response != null)
            Nav.NavigateTo($"game/{response.GameState.Id}?spectatorId={response.SpectatorId}");
        else
            _error = error ?? "No se pudo ver la partida";
    }

    private static string StatusLabel(Triker.Shared.Models.GameStatus s) => s switch
    {
        Triker.Shared.Models.GameStatus.Waiting => "Esperando",
        Triker.Shared.Models.GameStatus.Playing => "En juego",
        Triker.Shared.Models.GameStatus.Revealing => "Revelando",
        Triker.Shared.Models.GameStatus.Finished => "Finalizada",
        _ => ""
    };

    public async ValueTask DisposeAsync()
    {
        if (_hubConnection != null)
            await _hubConnection.DisposeAsync();
    }
}
