@page "/game/{GameId:guid}"
@inject ApiService Api
@inject HubService Hub
@inject SessionService Session
@inject NavigationManager Nav
@inject IConfiguration Config
@inject AudioService Audio
@inject ShareService ShareSvc
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="game-room">
    @if (_reconnecting)
    {
        <div class="reconnect-banner reconnect-warn">⟳ Reconectando...</div>
    }
    else if (_connectionClosed)
    {
        <div class="reconnect-banner reconnect-error">
            Conexión perdida. <button class="btn-reload" @onclick="Reload">Recargar</button>
        </div>
    }

    @if (_turnTimedOut)
    {
        <div class="reconnect-banner timeout-banner">
            ⏱ Se acabó tu tiempo: pasaste sin descartar.
            <button class="btn-dismiss" @onclick="() => _turnTimedOut = false" title="Cerrar">✕</button>
        </div>
    }

    @if (_state == null)
    {
        <div class="loading">Conectando a la partida...</div>
    }
    else if (_state.Status == GameStatus.Finished && _results != null)
    {
        <ResultsView Results="_results" GameName="@_state.Name" RoundNumber="_state.RoundNumber"
                     MyPlayerId="_myPlayerId"
                     OnContinue="HandleContinue"
                     Players="_state.Players"
                     TargetWins="_state.TargetWins"
                     GameOver="_state.GameOver"
                     IsSpectator="IsSpectator" />
    }
    else
    {
        <HelpModal Visible="_helpVisible" OnClose="@(() => _helpVisible = false)" />
        @* Dos grupos para que el ajuste de linea sea predecible: la parte de la
           izquierda crece y trunca el titulo; los controles nunca se parten. *@
        <div class="game-header">
            <div class="game-header-main">
                <span class="game-title-small" title="@_state.Name">@_state.Name</span>
                @* Ronda y mazo no significan nada antes de repartir. *@
                @if (_state.Status != GameStatus.Waiting)
                {
                    <span class="round-badge">Ronda @_state.RoundNumber</span>
                }
                @if (_state.TargetWins > 0)
                {
                    <span class="target-badge">Meta @_state.TargetWins🥇</span>
                }
                @if (IsSpectator)
                {
                    <span class="spectator-badge">👁 Modo espectador</span>
                }
                else if (_state.Spectators.Count > 0)
                {
                    <span class="spectator-count" title="@string.Join(", ", _state.Spectators.Select(s => s.Name))">
                        👁 @_state.Spectators.Count
                    </span>
                }
            </div>
            <div class="game-header-actions">
                @if (_state.Status != GameStatus.Waiting)
                {
                    <DeckView DeckSize="_state.DeckSize" />
                }
                <button class="btn-mute" @onclick="@(() => Audio.Enabled = !Audio.Enabled)"
                        title="@(Audio.Enabled ? "Silenciar" : "Activar sonido")">
                    @(Audio.Enabled ? "🔊" : "🔇")
                </button>
                <button class="btn-help" @onclick="@(() => _helpVisible = true)" title="Ayuda">?</button>
                @if (IsSpectator)
                {
                    <button class="btn-secondary btn-leave-spectate" @onclick="LeaveSpectate">Salir</button>
                }
            </div>
        </div>

        @if (_state.Status == GameStatus.Waiting)
        {
            <div class="waiting-room">
                <h2>Sala de espera</h2>
                @if (_state.IsPrivate && !string.IsNullOrEmpty(_state.AccessCode))
                {
                    <div class="private-code-banner">
                        <span class="private-code-label">🔒 Código privado</span>
                        <button class="private-code-value btn-copy-code" title="Copiar el código"
                                @onclick="CopyCode">@_state.AccessCode 📋</button>
                        <span class="private-code-hint">Compártelo con tus amigos para que puedan unirse</span>
                    </div>
                }
                @if (!IsSpectator)
                {
                    <div class="invite-row">
                        <button class="btn-primary btn-invite" @onclick="InviteFriends">
                            👥 Invitar a un amigo
                        </button>
                        @if (_inviteNotice != null)
                        {
                            <span class="share-notice">@_inviteNotice</span>
                        }
                    </div>
                }
                @if (IsSpectator)
                {
                    <p class="waiting-msg">Esperas a que la partida comience…</p>
                }
                else if (_myPlayerId == _state.CreatorId)
                {
                    <div class="waiting-actions">
                        @if (_state.Players.Count < MaxPlayers)
                        {
                            <button class="btn-secondary" @onclick="AddBot">+ Añadir bot</button>
                        }
                        <button class="btn-primary btn-start" @onclick="StartGame"
                                disabled="@(_state.Players.Count < 2)">▶ Iniciar partida</button>
                    </div>
                }
                else
                {
                    <p class="waiting-msg">Esperando a que el creador inicie la partida...</p>
                }
                <div class="players-waiting">
                    @foreach (var p in _state.Players)
                    {
                        <div class="waiting-player">
                            <span class="player-dot">@(p.IsBot ? "○" : "●")</span>
                            <span>@p.Name</span>
                            @if (p.Id == _state.CreatorId)
                            {
                                <span class="player-tag">(Creador)</span>
                            }
                            @if (p.IsBot)
                            {
                                <span class="player-tag tag-bot">Bot</span>
                            }
                        </div>
                    }
                </div>
                <p class="waiting-info">
                    @_state.Players.Count / @MaxPlayers jugadores
                    (mínimo 2, máximo @MaxPlayers)
                </p>
            </div>
        }
        else
        {
            @if (_lastRoundResults != null && _historyVisible)
            {
                <div class="info-row">
                    <div class="info-col">
                        <RoundHistoryPanel Results="_lastRoundResults" RoundNumber="_lastRoundNumber"
                                           OnClose="@(() => _historyVisible = false)" />
                    </div>
                    <div class="info-col">
                        <SessionStatsPanel Players="_state.Players" RoundNumber="_lastRoundNumber"
                                           MyPlayerId="_myPlayerId" />
                    </div>
                </div>
            }

                var me = IsSpectator ? null : _state.Players.FirstOrDefault(p => p.Id == _myPlayerId);

            @if (me != null)
            {
                <div class="my-area @(me.IsCurrentTurn && _state.Status == GameStatus.Playing && !_discarded ? "active-turn" : "")">
                    @if (_reactions.TryGetValue(me.Id, out var myRx))
                    {
                        <span class="reaction-bubble" @key="myRx.Seq">@myRx.Emoji</span>
                    }
                    <div class="my-area-header">
                        <span class="my-name">@me.Name (tú)</span>
                        @if (me.Wins > 0 || me.Seconds > 0 || me.Thirds > 0)
                        {
                            <span class="player-medals">
                                @if (me.Wins > 0)    { <span>🥇@me.Wins</span> }
                                @if (me.Seconds > 0) { <span>🥈@me.Seconds</span> }
                                @if (me.Thirds > 0)  { <span>🥉@me.Thirds</span> }
                            </span>
                        }
                        @if (_state.Status == GameStatus.Playing)
                        {
                            @if (_discarded && me.IsCurrentTurn)
                            {
                                <span class="turn-indicator discarded-ok">Descarte enviado ✓</span>
                            }
                            else if (me.IsCurrentTurn)
                            {
                                <span class="turn-indicator my-turn">¡Tu turno!</span>
                                @if (_turnSecondsLeft > 0)
                                {
                                    <div class="turn-countdown">
                                        <span class="countdown-secs">@_turnSecondsLeft s</span>
                                        <div class="countdown-bar">
                                            <div class="countdown-fill @CountdownClass"
                                                 style="width:@(_turnSecondsLeft / 60.0 * 100)%"></div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                var current = _state.Players.ElementAtOrDefault(_state.CurrentTurnIndex);
                                <span class="turn-indicator waiting-turn">Turno de @(current?.Name ?? "...")</span>
                            }
                        }
                        else if (_state.Status == GameStatus.Revealing)
                        {
                            <span class="turn-indicator revealing">Revelando cartas...</span>
                        }
                    </div>

                    @if (me.Play != null && _state.Status == GameStatus.Playing)
                    {
                        <div class="my-play-badge">
                            <span class="my-play-label">Tu jugada:</span>
                            <PlayBadge Result="me.Play" />
                        </div>
                    }

                    <HandView Cards="me.Hand"
                              CanDiscard="@(me.IsCurrentTurn && _state.Status == GameStatus.Playing && !_discarded)"
                              OnDiscard="HandleDiscard" />

                    @if (me.TurnStatus == PlayerTurnStatus.Ready && _state.Status == GameStatus.Playing)
                    {
                        @if (me.DiscardCount > 0)
                        {
                            <div class="discard-section">
                                <span class="discard-section-label">Descartaste @me.DiscardCount</span>
                                <div class="discard-pile-row">
                                    @for (int i = 0; i < me.DiscardCount; i++)
                                    {
                                        <CardView FaceDown="true" />
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="discard-info">Pasaste sin descartar</div>
                        }
                    }
                </div>
            }

            <OtherPlayersView Players="_state.Players" MyPlayerId="_myPlayerId" Reactions="_reactions" />

            @if (!IsSpectator)
            {
                <div class="reaction-toolbar">
                    @foreach (var emoji in _emojis)
                    {
                        <button class="reaction-btn" @onclick="() => SendReaction(emoji)" title="Reaccionar @emoji">@emoji</button>
                    }
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-msg">@_error</div>
        }
    }
</div>

@code {
    [Parameter] public Guid GameId { get; set; }

    private GameStateDto? _state;
    private List<HandResultDto>? _results;
    private List<HandResultDto>? _lastRoundResults;
    private int _lastRoundNumber;
    private bool _historyVisible = true;
    private bool _wasMyTurn = false;
    private Guid _myPlayerId;
    private Guid? _spectatorId;
    private bool IsSpectator => _spectatorId.HasValue;
    private bool _discarded = false;
    private bool _helpVisible = false;
    private bool _reconnecting = false;
    private bool _turnTimedOut = false;
    private bool _connectionClosed = false;
    private string _error = "";
    private int _turnSecondsLeft;
    private CancellationTokenSource? _countdownCts;

    private static readonly string[] _emojis = ["👍", "❤️", "😂", "😮", "😢", "🎉"];
    private readonly Dictionary<Guid, ReactionEntry> _reactions = [];
    private int _reactionSeq = 0;
    private static readonly TimeSpan ReactionTtl = TimeSpan.FromSeconds(2.5);

    private string? _inviteNotice;

    private int MaxPlayers => _state != null ? Math.Min(16, (int)Math.Floor((double)(_state.N * _state.N) / 2)) : 0;
    private string CountdownClass => _turnSecondsLeft switch { <= 10 => "countdown-danger", <= 20 => "countdown-warn", _ => "countdown-ok" };

    protected override async Task OnInitializedAsync()
    {
        await Audio.EnsureInitializedAsync();
        _spectatorId = ParseGuidParamFromUrl(Nav.Uri, "spectatorId");
        if (!_spectatorId.HasValue)
        {
            _myPlayerId = ParseGuidParamFromUrl(Nav.Uri, "playerId")
                ?? await Session.GetOrCreatePlayerId();
        }

        Hub.OnChange += OnHubChange;
        Hub.OnHandsRevealed += OnHandsRevealed;
        Hub.OnAutoLeft += OnAutoLeft;
        Hub.OnTurnTimedOut += OnTurnTimedOut;
        Hub.OnReconnecting += OnHubReconnecting;
        Hub.OnReconnected += OnHubReconnected;
        Hub.OnConnectionClosed += OnHubConnectionClosed;
        Hub.OnReaction += OnReaction;

        var apiBase = GetApiBase();
        var id = _spectatorId ?? _myPlayerId;
        await Hub.Connect(apiBase, GameId, id, asSpectator: IsSpectator);

        if (_state == null && !IsSpectator)
        {
            _state = await Api.GetGameState(GameId, _myPlayerId);
            StateHasChanged();
        }
    }

    private void OnHubChange()
    {
        _state = Hub.GameState;
        _reconnecting = false;
        if (_state?.Status == GameStatus.Playing)
        {
            var me = _state.Players.FirstOrDefault(p => p.Id == _myPlayerId);
            if (me != null)
            {
                if (me.TurnStatus == PlayerTurnStatus.Thinking || !me.IsCurrentTurn)
                    _discarded = false;

                // El aviso lo enciende el evento del hub y lo apaga el estado:
                // el servidor reinicia TurnTimedOut al repartir la ronda nueva.
                if (!me.TurnTimedOut) _turnTimedOut = false;

                if (me.IsCurrentTurn && !_discarded && _state.TurnDeadline.HasValue)
                    StartCountdown(_state.TurnDeadline.Value);
                else
                    StopCountdown();

                if (me.IsCurrentTurn && !_discarded && !_wasMyTurn)
                    InvokeAsync(Audio.PlayYourTurn);
                _wasMyTurn = me.IsCurrentTurn && !_discarded;
            }
        }
        else
        {
            StopCountdown();
            _discarded = false;
            _wasMyTurn = false;
        }
        InvokeAsync(StateHasChanged);
    }

    private void OnHubReconnecting()
    {
        _reconnecting = true;
        _connectionClosed = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnHubReconnected()
    {
        _reconnecting = false;
        _connectionClosed = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnHubConnectionClosed()
    {
        _reconnecting = false;
        _connectionClosed = true;
        InvokeAsync(StateHasChanged);
    }

    private void Reload() => Nav.NavigateTo(Nav.Uri, forceLoad: true);

    // Enlace que abre el lobby con la partida ya elegida y, si es privada, el
    // codigo puesto (ver el bloque de invitacion en Lobby.razor).
    private string InviteLink()
    {
        var link = $"{Nav.BaseUri.TrimEnd('/')}/?join={GameId}";
        if (_state?.IsPrivate == true && !string.IsNullOrEmpty(_state.AccessCode))
            link += $"&code={_state.AccessCode}";
        return link;
    }

    private async Task InviteFriends()
    {
        if (_state == null) return;

        // El codigo va tambien en texto: hay clientes de mensajeria que recortan
        // la query del enlace al generar la vista previa.
        var text = $"🎴 ¡Te invito a jugar a Triker! Partida: \"{_state.Name}\"\n" +
                    (_state.IsPrivate && !string.IsNullOrEmpty(_state.AccessCode)
                        ? $"🔒 Código: {_state.AccessCode}\n"
                        : "") +
                    $"👉 {InviteLink()}";

        var outcome = await ShareSvc.Share(text);
        await ShowInviteNotice(outcome switch
        {
            "copied" => "¡Invitación copiada al portapapeles!",
            "unsupported" or "error" => "No se pudo compartir la invitación",
            _ => null,
        });
    }

    private async Task CopyCode()
    {
        if (string.IsNullOrEmpty(_state?.AccessCode)) return;
        var outcome = await ShareSvc.Copy(_state.AccessCode);
        await ShowInviteNotice(outcome == "copied" ? "¡Código copiado!" : "No se pudo copiar el código");
    }

    private async Task ShowInviteNotice(string? notice)
    {
        _inviteNotice = notice;
        StateHasChanged();
        if (notice == null) return;

        await Task.Delay(2500);
        _inviteNotice = null;
        StateHasChanged();
    }

    private void StartCountdown(DateTimeOffset deadline)
    {
        _countdownCts?.Cancel();
        _countdownCts = new CancellationTokenSource();
        var token = _countdownCts.Token;
        _ = RunCountdown(deadline, token);
    }

    private async Task RunCountdown(DateTimeOffset deadline, CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            _turnSecondsLeft = Math.Max(0, (int)(deadline - DateTimeOffset.UtcNow).TotalSeconds);
            await InvokeAsync(StateHasChanged);
            if (_turnSecondsLeft <= 0) break;
            try { await Task.Delay(250, token); }
            catch (OperationCanceledException) { break; }
        }
    }

    private void StopCountdown()
    {
        _countdownCts?.Cancel();
        _countdownCts = null;
        _turnSecondsLeft = 0;
    }

    private void OnHandsRevealed(List<HandResultDto> results)
    {
        _lastRoundResults = null;
        _results = results;

        var myResult = results.FirstOrDefault(r => r.PlayerId == _myPlayerId);
        if (myResult != null)
        {
            bool iWon = results.Count(r => r.HandRank > myResult.HandRank) == 0;
            if (_state?.GameOver == true && iWon)
                InvokeAsync(Audio.PlayChampion);
            else if (iWon)
                InvokeAsync(Audio.PlayWinRound);
            else
                InvokeAsync(Audio.PlayLoseRound);
        }

        // Intersticial AdMob entre partidas (solo surte efecto dentro de la app Android).
        if (!IsSpectator)
            _ = ShowInterstitialAd();

        InvokeAsync(StateHasChanged);
    }

    private async Task ShowInterstitialAd()
    {
        try { await JS.InvokeVoidAsync("TrikerAds.interstitial"); }
        catch { /* sin puente de anuncios (web normal) */ }
    }

    // Volver al lobby es subir un nivel, no avanzar: con replace, el lobby
    // sustituye a la partida en el historial en vez de apilarse encima. Sin
    // esto, "atras" desde el lobby volvia a meterte en la partida que acababas
    // de dejar (el boton de Android hace webView.goBack, ver MainActivity.kt).
    private void GoToLobby() => Nav.NavigateTo("", replace: true);

    private void OnAutoLeft()
        => InvokeAsync(GoToLobby);

    // No se cierra solo: si el turno se agoto es porque el jugador no estaba
    // mirando, y un aviso que se desvanece es justo el que se pierde. Se quita
    // al empezar la ronda siguiente (ver el reparto en OnStateChanged).
    private void OnTurnTimedOut()
    {
        _turnTimedOut = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task AddBot()
    {
        var ok = await Api.AddBot(GameId, _myPlayerId);
        if (!ok) _error = "No se pudo añadir el bot";
    }

    private async Task StartGame()
    {
        var ok = await Api.StartGame(GameId, _myPlayerId);
        if (!ok) _error = "No se pudo iniciar la partida";
    }

    private async Task HandleDiscard(List<Guid> cardIds)
    {
        _discarded = true;
        StopCountdown();
        var ok = await Api.Discard(GameId, _myPlayerId, new() { CardIds = cardIds });
        if (!ok) { _error = "Error al descartar"; _discarded = false; }
    }

    private async Task SendReaction(string emoji)
        => await Api.SendReaction(GameId, _myPlayerId, emoji);

    private async Task LeaveSpectate()
    {
        if (_spectatorId.HasValue)
            await Api.LeaveSpectate(GameId, _spectatorId.Value);
        GoToLobby();
    }

    private void OnReaction(ChatReactionDto r)
    {
        var seq = ++_reactionSeq;
        _reactions[r.PlayerId] = new ReactionEntry(r.Emoji, seq);
        InvokeAsync(StateHasChanged);
        _ = ClearReactionAfter(r.PlayerId, seq);
    }

    private async Task ClearReactionAfter(Guid playerId, int seq)
    {
        await Task.Delay(ReactionTtl);
        if (_reactions.TryGetValue(playerId, out var current) && current.Seq == seq)
        {
            _reactions.Remove(playerId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleContinue(bool wantsToContinue)
    {
        if (IsSpectator)
        {
            await LeaveSpectate();
            return;
        }

        if (wantsToContinue && _results != null)
        {
            _lastRoundResults = _results;
            _lastRoundNumber = _state?.RoundNumber ?? 0;
            _historyVisible = true;
        }
        _results = null;
        _discarded = false;
        await Api.Continue(GameId, _myPlayerId, new() { WantsToContinue = wantsToContinue });
        if (!wantsToContinue) GoToLobby();
    }

    private string GetApiBase()
        => Config["ApiBaseUrl"] ?? "https://localhost:7077";

    private static Guid? ParseGuidParamFromUrl(string url, string paramName)
    {
        var query = new Uri(url).Query.TrimStart('?');
        foreach (var part in query.Split('&'))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0] == paramName
                && Guid.TryParse(Uri.UnescapeDataString(kv[1]), out var id))
                return id;
        }
        return null;
    }

    public async ValueTask DisposeAsync()
    {
        StopCountdown();
        Hub.OnChange -= OnHubChange;
        Hub.OnHandsRevealed -= OnHandsRevealed;
        Hub.OnAutoLeft -= OnAutoLeft;
        Hub.OnTurnTimedOut -= OnTurnTimedOut;
        Hub.OnReconnecting -= OnHubReconnecting;
        Hub.OnReconnected -= OnHubReconnected;
        Hub.OnConnectionClosed -= OnHubConnectionClosed;
        Hub.OnReaction -= OnReaction;
        await Hub.DisposeAsync();
    }
}
