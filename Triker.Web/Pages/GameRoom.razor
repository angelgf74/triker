@page "/game/{GameId:guid}"
@inject ApiService Api
@inject HubService Hub
@inject SessionService Session
@inject NavigationManager Nav
@inject IConfiguration Config
@inject AudioService Audio
@inject ShareService ShareSvc
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(EsMiTurno ? "¡Tu turno! · Triker" : "Triker")</PageTitle>

@* Lo que solo se ve (turno, resultados) se anuncia tambien a los lectores de pantalla. *@
<div class="sr-only" aria-live="polite">@_anuncio</div>

<div class="game-room">
    @if (_reconnecting)
    {
        <div class="reconnect-banner reconnect-warn" role="status">⟳ Reconectando...</div>
    }
    else if (_connectionClosed)
    {
        <div class="reconnect-banner reconnect-error" role="alert">
            Conexión perdida. <button class="btn-reload" @onclick="Reload">Recargar</button>
        </div>
    }

    @if (_turnTimedOut)
    {
        <div class="reconnect-banner timeout-banner" role="alert">
            ⏱ Se acabó tu tiempo: pasaste sin descartar.
            <button class="btn-dismiss" @onclick="() => _turnTimedOut = false" title="Cerrar" aria-label="Cerrar aviso">✕</button>
        </div>
    }

    @if (_fallo != Fallo.Ninguno)
    {
        <div class="room-problem">
            @switch (_fallo)
            {
                case Fallo.SinAsiento:
                    <h1 class="room-problem-title" tabindex="-1">No formas parte de esta partida</h1>
                    <p>Puede que la abrieras en otro dispositivo o navegador. Si aún está esperando jugadores, puedes unirte.</p>
                    <div class="room-problem-actions">
                        <button class="btn-primary" @onclick="JoinFromLobby">Unirme a la partida</button>
                        <button class="btn-secondary" @onclick="GoToLobby">Volver al inicio</button>
                    </div>
                    break;
                case Fallo.NoExiste:
                    <h1 class="room-problem-title" tabindex="-1">Esta partida ya no existe</h1>
                    <p>Las partidas se cierran cuando se van todos los jugadores o tras un rato sin actividad.</p>
                    <div class="room-problem-actions">
                        <button class="btn-primary" @onclick="GoToLobby">Volver al inicio</button>
                    </div>
                    break;
                case Fallo.AsientoPerdido:
                    <h1 class="room-problem-title" tabindex="-1">Ya no estás en esta partida</h1>
                    <p>Saliste de la mesa o se cerró mientras estabas desconectado.</p>
                    <div class="room-problem-actions">
                        <button class="btn-primary" @onclick="GoToLobby">Volver al inicio</button>
                    </div>
                    break;
                default:
                    <h1 class="room-problem-title" tabindex="-1">No se puede conectar con el servidor</h1>
                    <p>Comprueba tu conexión a internet.</p>
                    <div class="room-problem-actions">
                        <button class="btn-primary" @onclick="Conectar">Reintentar</button>
                        <button class="btn-secondary" @onclick="GoToLobby">Volver al inicio</button>
                    </div>
                    break;
            }
        </div>
    }
    else if (_state == null)
    {
        <div class="loading" role="status">Conectando a la partida...</div>
    }
    else if (_results != null && (_state.Status == GameStatus.Finished || _state.Status == GameStatus.Revealing))
    {
        <ResultsView Results="_results" GameName="@_state.Name" RoundNumber="_resultsRound"
                     MyPlayerId="_myPlayerId"
                     OnContinue="HandleContinue"
                     Players="_state.Players"
                     TargetWins="_state.TargetWins"
                     GameOver="_state.GameOver"
                     IsSpectator="IsSpectator"
                     Decided="@(_deciding || Me?.WantsToContinue == true)"
                     ContinueDeadline="_state.ContinueDeadline" />
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-msg" role="alert">@_error</div>
        }
    }
    else
    {
        <HelpModal Visible="_helpVisible" OnClose="@(() => _helpVisible = false)" />
        @* Dos grupos para que el ajuste de linea sea predecible: la parte de la
           izquierda crece y trunca el titulo; los controles nunca se parten. *@
        <div class="game-header">
            <div class="game-header-main">
                <h1 class="game-title-small" title="@_state.Name" tabindex="-1">@_state.Name</h1>
                @* Ronda y mazo no significan nada antes de repartir. *@
                @if (_state.Status != GameStatus.Waiting)
                {
                    <span class="round-badge">Ronda @_state.RoundNumber</span>
                }
                @if (_state.TargetWins > 0)
                {
                    <span class="target-badge">Meta @_state.TargetWins🥇</span>
                }
                @if (IsSpectator)
                {
                    <span class="spectator-badge">👁 Modo espectador</span>
                }
                else if (_state.Spectators.Count > 0)
                {
                    <span class="spectator-count" title="@string.Join(", ", _state.Spectators.Select(s => s.Name))">
                        👁 @_state.Spectators.Count
                    </span>
                }
            </div>
            <div class="game-header-actions">
                @if (_state.Status != GameStatus.Waiting)
                {
                    <DeckView DeckSize="_state.DeckSize" />
                }
                <button class="btn-mute" @onclick="@(() => Audio.Enabled = !Audio.Enabled)"
                        title="@(Audio.Enabled ? "Silenciar" : "Activar sonido")"
                        aria-label="@(Audio.Enabled ? "Silenciar" : "Activar sonido")">
                    @(Audio.Enabled ? "🔊" : "🔇")
                </button>
                <button class="btn-help" @onclick="@(() => _helpVisible = true)" title="Ayuda" aria-label="Cómo se juega">?</button>
                @if (IsSpectator)
                {
                    <button class="btn-secondary btn-leave-spectate" @onclick="LeaveSpectate">Salir</button>
                }
                else
                {
                    @* En la sala de espera sale sin mas; con cartas repartidas
                       pregunta antes, porque pierde el sitio y la mano. *@
                    <button class="btn-secondary btn-leave" disabled="@_leaving"
                            @onclick="@(() => _state.Status == GameStatus.Waiting ? LeaveGame() : AskLeave())">Salir</button>
                }
            </div>
        </div>

        @if (_confirmLeave)
        {
            <div class="leave-confirm" role="alertdialog" aria-labelledby="leave-pregunta">
                <p id="leave-pregunta">¿Salir de la partida? Pierdes tu sitio y tu mano de esta ronda no cuenta.</p>
                <div class="leave-confirm-actions">
                    <button class="btn-secondary" @onclick="@(() => _confirmLeave = false)" disabled="@_leaving">Seguir jugando</button>
                    <button class="btn-danger" @onclick="LeaveGame" disabled="@_leaving">Salir</button>
                </div>
            </div>
        }

        @if (_state.Status == GameStatus.Waiting)
        {
            <div class="waiting-room">
                <h2>Sala de espera</h2>
                @if (_state.IsPrivate && !string.IsNullOrEmpty(_state.AccessCode))
                {
                    <div class="private-code-banner">
                        <span class="private-code-label">🔒 Código privado</span>
                        <button class="private-code-value btn-copy-code" title="Copiar el código"
                                aria-label="Copiar el código @_state.AccessCode"
                                @onclick="CopyCode">@_state.AccessCode<span class="copy-icon" aria-hidden="true">📋</span></button>
                        <span class="private-code-hint">Compártelo con tus amigos para que puedan unirse</span>
                    </div>
                }
                @if (!IsSpectator)
                {
                    <div class="invite-row">
                        <button class="@(_state.Players.Count < 2 ? "btn-primary" : "btn-secondary") btn-invite" @onclick="InviteFriends">
                            👥 Invitar a un amigo
                        </button>
                        @if (_inviteNotice != null)
                        {
                            <span class="share-notice" role="status">@_inviteNotice</span>
                        }
                    </div>
                }
                @if (IsSpectator)
                {
                    <p class="waiting-msg">Esperas a que la partida comience…</p>
                }
                else if (_myPlayerId == _state.CreatorId)
                {
                    <div class="waiting-actions">
                        @if (_state.Players.Count < MaxPlayers)
                        {
                            <button class="btn-secondary" @onclick="AddBot">+ Añadir bot</button>
                        }
                        <button class="btn-primary btn-start" @onclick="StartGame"
                                disabled="@(_state.Players.Count < 2)">▶ Iniciar partida</button>
                    </div>
                    @if (_state.Players.Count < 2)
                    {
                        <p class="waiting-msg">Añade un bot o invita a alguien para empezar.</p>
                    }
                }
                else
                {
                    <p class="waiting-msg">Esperando a que el creador inicie la partida...</p>
                }
                <div class="players-waiting">
                    @foreach (var p in _state.Players)
                    {
                        <div class="waiting-player">
                            <span class="player-dot" aria-hidden="true">@(p.IsBot ? "○" : "●")</span>
                            <span>@p.Name</span>
                            @if (p.Id == _state.CreatorId)
                            {
                                <span class="player-tag">(Creador)</span>
                            }
                            @if (p.IsBot)
                            {
                                <span class="player-tag tag-bot">Bot</span>
                            }
                        </div>
                    }
                </div>
                <p class="waiting-info">
                    @_state.Players.Count / @MaxPlayers jugadores
                    (mínimo 2, máximo @MaxPlayers)
                </p>
            </div>
        }
        else
        {
            @if (_lastRoundResults != null && _historyVisible)
            {
                <div class="info-row">
                    <div class="info-col">
                        <RoundHistoryPanel Results="_lastRoundResults" RoundNumber="_lastRoundNumber"
                                           OnClose="@(() => _historyVisible = false)" />
                    </div>
                    <div class="info-col">
                        <SessionStatsPanel Players="_state.Players" RoundNumber="_lastRoundNumber"
                                           MyPlayerId="_myPlayerId" />
                    </div>
                </div>
            }

            var me = Me;

            @if (me != null)
            {
                <div class="my-area @(me.IsCurrentTurn && _state.Status == GameStatus.Playing && !_discarded ? "active-turn" : "")">
                    @if (_reactions.TryGetValue(me.Id, out var myRx))
                    {
                        <span class="reaction-bubble" @key="myRx.Seq">@myRx.Emoji</span>
                    }
                    <div class="my-area-header">
                        <span class="my-name">@me.Name (tú)</span>
                        @if (me.Wins > 0 || me.Seconds > 0 || me.Thirds > 0)
                        {
                            <span class="player-medals">
                                @if (me.Wins > 0)    { <span title="Primeros puestos">🥇@me.Wins</span> }
                                @if (me.Seconds > 0) { <span title="Segundos puestos">🥈@me.Seconds</span> }
                                @if (me.Thirds > 0)  { <span title="Terceros puestos">🥉@me.Thirds</span> }
                            </span>
                        }
                        @if (_state.Status == GameStatus.Playing)
                        {
                            @if (_discarded && me.IsCurrentTurn)
                            {
                                <span class="turn-indicator discarded-ok">Descarte enviado ✓</span>
                            }
                            else if (me.IsCurrentTurn)
                            {
                                <span class="turn-indicator my-turn">¡Tu turno!</span>
                                @if (_turnSecondsLeft > 0)
                                {
                                    <div class="turn-countdown">
                                        <span class="countdown-secs">@_turnSecondsLeft s</span>
                                        <div class="countdown-bar" aria-hidden="true">
                                            <div class="countdown-fill @CountdownClass"
                                                 style="width:@(CountdownPercent)%"></div>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                var current = _state.Players.ElementAtOrDefault(_state.CurrentTurnIndex);
                                <span class="turn-indicator waiting-turn">Turno de @(current?.Name ?? "...")</span>
                            }
                        }
                        else if (_state.Status == GameStatus.Revealing)
                        {
                            <span class="turn-indicator revealing">Revelando cartas...</span>
                        }
                    </div>

                    @if (me.Play != null && _state.Status == GameStatus.Playing)
                    {
                        <div class="my-play-badge">
                            <span class="my-play-label">Tu jugada:</span>
                            <PlayBadge Result="me.Play" />
                        </div>
                    }

                    <HandView Cards="me.Hand"
                              CanDiscard="@(me.IsCurrentTurn && _state.Status == GameStatus.Playing && !_discarded)"
                              OnDiscard="HandleDiscard" />

                    @if (me.TurnStatus == PlayerTurnStatus.Ready && _state.Status == GameStatus.Playing)
                    {
                        @if (me.DiscardCount > 0)
                        {
                            <div class="discard-section">
                                <span class="discard-section-label">Descartaste @me.DiscardCount</span>
                                <div class="discard-pile-row" aria-hidden="true">
                                    @for (int i = 0; i < me.DiscardCount; i++)
                                    {
                                        <CardView FaceDown="true" />
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="discard-info">Pasaste sin descartar</div>
                        }
                    }
                </div>
            }

            <OtherPlayersView Players="_state.Players" MyPlayerId="_myPlayerId" Reactions="_reactions" />

            @if (!IsSpectator)
            {
                <div class="reaction-toolbar" role="group" aria-label="Reacciones">
                    @foreach (var emoji in _emojis)
                    {
                        <button class="reaction-btn" @onclick="() => SendReaction(emoji)"
                                title="Reaccionar @emoji" aria-label="Reaccionar @emoji">@emoji</button>
                    }
                </div>
            }
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="error-msg" role="alert">@_error</div>
        }
    }
</div>

@code {
    [Parameter] public Guid GameId { get; set; }

    private enum Fallo { Ninguno, SinAsiento, NoExiste, SinConexion, AsientoPerdido }

    private Asiento? _asiento;
    private Fallo _fallo = Fallo.Ninguno;
    private GameStateDto? _state;
    private List<HandResultDto>? _results;
    private int _resultsRound;
    private List<HandResultDto>? _lastRoundResults;
    private int _lastRoundNumber;
    private bool _historyVisible = true;
    private bool _wasMyTurn = false;
    private Guid _myPlayerId;
    private bool IsSpectator => _asiento?.Espectador == true;
    private bool _discarded = false;
    private bool _deciding = false;
    private bool _confirmLeave = false;
    private bool _leaving = false;
    private bool _helpVisible = false;
    private bool _reconnecting = false;
    private bool _turnTimedOut = false;
    private bool _connectionClosed = false;
    private bool _subscribed = false;
    private string _error = "";
    private string _anuncio = "";
    private int _turnSecondsLeft;
    private CancellationTokenSource? _countdownCts;

    private static readonly string[] _emojis = ["👍", "❤️", "😂", "😮", "😢", "🎉"];
    private readonly Dictionary<Guid, ReactionEntry> _reactions = [];
    private int _reactionSeq = 0;
    private static readonly TimeSpan ReactionTtl = TimeSpan.FromSeconds(2.5);

    private string? _inviteNotice;

    private PlayerDto? Me => IsSpectator || _state == null ? null : _state.Players.FirstOrDefault(p => p.Id == _myPlayerId);
    private bool EsMiTurno => _state?.Status == GameStatus.Playing && Me?.IsCurrentTurn == true && !_discarded;

    private int MaxPlayers => _state != null ? Math.Min(16, (int)Math.Floor((double)(_state.N * _state.N) / 2)) : 0;
    // Entero a proposito: un decimal se escribe con la cultura del navegador y
    // en español sale "93,33%", que no es CSS valido (la barra se quedaba
    // siempre llena). El tope cubre un reloj del dispositivo atrasado.
    private int CountdownPercent => Math.Clamp(_turnSecondsLeft * 100 / TurnSeconds, 0, 100);
    private const int TurnSeconds = 60; // InactivityService.TurnTimeout en la API
    private string CountdownClass =>_turnSecondsLeft switch { <= 10 => "countdown-danger", <= 20 => "countdown-warn", _ => "countdown-ok" };

    protected override async Task OnInitializedAsync()
    {
        await Audio.EnsureInitializedAsync();

        // El asiento (id + token) sale de localStorage; la URL solo dice cual.
        // Sin ?playerId ni ?spectatorId vale el que tengas en esta partida.
        var spectatorId = ParseGuidParamFromUrl(Nav.Uri, "spectatorId");
        _asiento = spectatorId is Guid sid
            ? await Session.BuscarAsiento(GameId, sid, espectador: true)
            : await Session.BuscarAsiento(GameId, ParseGuidParamFromUrl(Nav.Uri, "playerId"), espectador: false);

        if (_asiento == null)
        {
            _fallo = Fallo.SinAsiento;
            return;
        }
        _myPlayerId = _asiento.Espectador ? Guid.Empty : _asiento.Id;

        Hub.OnChange += OnHubChange;
        Hub.OnHandsRevealed += OnHandsRevealed;
        Hub.OnAutoLeft += OnAutoLeft;
        Hub.OnTurnTimedOut += OnTurnTimedOut;
        Hub.OnReconnecting += OnHubReconnecting;
        Hub.OnReconnected += OnHubReconnected;
        Hub.OnConnectionClosed += OnHubConnectionClosed;
        Hub.OnSeatLost += OnSeatLost;
        Hub.OnReaction += OnReaction;
        _subscribed = true;

        await Conectar();
    }

    // Primero el estado por REST (dice si la partida existe y el asiento vale)
    // y luego el hub. Antes, una partida inexistente dejaba "Conectando..."
    // para siempre con la barra roja generica de Blazor.
    private async Task Conectar()
    {
        if (_asiento == null) return;
        _fallo = Fallo.Ninguno;
        _connectionClosed = false;

        var (state, resultado) = await Api.GetGameState(_asiento);
        if (resultado == ResultadoEstado.NoEncontrada)
        {
            await Session.OlvidarAsiento(_asiento.GameId, _asiento.Id);
            _fallo = Fallo.NoExiste;
            return;
        }
        if (resultado != ResultadoEstado.Ok || state == null)
        {
            _fallo = Fallo.SinConexion;
            return;
        }

        ApplyState(state);
        StateHasChanged();

        if (!await Hub.Connect(GetApiBase(), _asiento))
            _connectionClosed = true;
    }

    private void OnHubChange()
    {
        if (Hub.GameState == null) return;
        _reconnecting = false;
        ApplyState(Hub.GameState);
        InvokeAsync(StateHasChanged);
    }

    private void ApplyState(GameStateDto state)
    {
        _state = state;
        SyncResults();
        SonidoDeFinDeRonda();

        var me = Me;
        if (_state.Status == GameStatus.Playing && me != null)
        {
            if (me.TurnStatus == PlayerTurnStatus.Thinking || !me.IsCurrentTurn)
                _discarded = false;

            // El aviso lo enciende el evento del hub y lo apaga el estado:
            // el servidor reinicia TurnTimedOut al repartir la ronda nueva.
            if (!me.TurnTimedOut) _turnTimedOut = false;

            if (me.IsCurrentTurn && !_discarded && _state.TurnDeadline.HasValue)
                StartCountdown(_state.TurnDeadline.Value);
            else
                StopCountdown();

            var myTurn = me.IsCurrentTurn && !_discarded;
            if (myTurn && !_wasMyTurn)
            {
                InvokeAsync(Audio.PlayYourTurn);
                _anuncio = $"Es tu turno (ronda {_state.RoundNumber})";
            }
            _wasMyTurn = myTurn;
        }
        else
        {
            StopCountdown();
            _discarded = false;
            _wasMyTurn = false;
        }

        if (_state.Status != GameStatus.Finished) _deciding = false;
        // La pregunta era sobre la ronda en curso: si ya no hay cartas en
        // juego, sobra (en resultados se sale con su propio boton).
        if (_state.Status is GameStatus.Waiting or GameStatus.Finished) _confirmLeave = false;
    }

    // Los resultados llegan por el evento HandsRevealed o, si se recarga o
    // reconecta en esa pantalla, en el propio estado. Al repartir la ronda
    // siguiente pasan al panel de historial.
    private void SyncResults()
    {
        if (_state == null) return;
        switch (_state.Status)
        {
            case GameStatus.Finished:
                if (_state.Results != null && (_results == null || _resultsRound != _state.RoundNumber))
                {
                    _results = _state.Results;
                    _resultsRound = _state.RoundNumber;
                }
                break;
            case GameStatus.Playing:
                if (_results != null)
                {
                    _lastRoundResults = _results;
                    _lastRoundNumber = _resultsRound;
                    _historyVisible = true;
                    _results = null;
                }
                break;
            case GameStatus.Waiting:
                // La mesa volvio a la sala de espera: lo de antes ya no aplica.
                _results = null;
                _lastRoundResults = null;
                break;
            // Revealing: se conserva lo que haya. Un estado Revealing rezagado
            // puede llegar justo despues de los resultados.
        }
    }

    private void OnHubReconnecting()
    {
        _reconnecting = true;
        _connectionClosed = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnHubReconnected()
    {
        _reconnecting = false;
        _connectionClosed = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnHubConnectionClosed()
    {
        _reconnecting = false;
        _connectionClosed = true;
        InvokeAsync(StateHasChanged);
    }

    private void OnSeatLost()
    {
        _reconnecting = false;
        _fallo = Fallo.AsientoPerdido;
        if (_asiento != null) _ = Session.OlvidarAsiento(_asiento.GameId, _asiento.Id);
        InvokeAsync(StateHasChanged);
    }

    private void Reload() => Nav.NavigateTo(Nav.Uri, forceLoad: true);

    // Enlace que abre el lobby con la partida ya elegida y, si es privada, el
    // codigo puesto (ver el bloque de invitacion en Lobby.razor).
    private string InviteLink()
    {
        var link = $"{Nav.BaseUri.TrimEnd('/')}/?join={GameId}";
        if (_state?.IsPrivate == true && !string.IsNullOrEmpty(_state.AccessCode))
            link += $"&code={_state.AccessCode}";
        return link;
    }

    private async Task InviteFriends()
    {
        if (_state == null) return;

        // El codigo va tambien en texto: hay clientes de mensajeria que recortan
        // la query del enlace al generar la vista previa.
        var text = $"🎴 ¡Te invito a jugar a Triker! Partida: \"{_state.Name}\"\n" +
                    (_state.IsPrivate && !string.IsNullOrEmpty(_state.AccessCode)
                        ? $"🔒 Código: {_state.AccessCode}\n"
                        : "") +
                    $"👉 {InviteLink()}";

        var outcome = await ShareSvc.Share(text);
        await ShowInviteNotice(outcome switch
        {
            "copied" => "¡Invitación copiada al portapapeles!",
            "unsupported" or "error" => "No se pudo compartir la invitación",
            _ => null,
        });
    }

    private async Task CopyCode()
    {
        if (string.IsNullOrEmpty(_state?.AccessCode)) return;
        var outcome = await ShareSvc.Copy(_state.AccessCode);
        await ShowInviteNotice(outcome == "copied" ? "¡Código copiado!" : "No se pudo copiar el código");
    }

    private async Task ShowInviteNotice(string? notice)
    {
        _inviteNotice = notice;
        StateHasChanged();
        if (notice == null) return;

        await Task.Delay(2500);
        _inviteNotice = null;
        StateHasChanged();
    }

    private void StartCountdown(DateTimeOffset deadline)
    {
        _countdownCts?.Cancel();
        _countdownCts = new CancellationTokenSource();
        var token = _countdownCts.Token;
        _ = RunCountdown(deadline, token);
    }

    private async Task RunCountdown(DateTimeOffset deadline, CancellationToken token)
    {
        while (!token.IsCancellationRequested)
        {
            _turnSecondsLeft = Math.Max(0, (int)(deadline - DateTimeOffset.UtcNow).TotalSeconds);
            await InvokeAsync(StateHasChanged);
            if (_turnSecondsLeft <= 0) break;
            try { await Task.Delay(250, token); }
            catch (OperationCanceledException) { break; }
        }
    }

    private void StopCountdown()
    {
        _countdownCts?.Cancel();
        _countdownCts = null;
        _turnSecondsLeft = 0;
    }

    private void OnHandsRevealed(List<HandResultDto> results)
    {
        _lastRoundResults = null;
        _results = results;
        _resultsRound = _state?.RoundNumber ?? 0;

        var myResult = results.FirstOrDefault(r => r.PlayerId == _myPlayerId);
        if (myResult != null)
        {
            var position = results.Count(r => r.HandRank > myResult.HandRank) + 1;
            _anuncio = $"Ronda {_resultsRound} terminada: quedas {position}º de {results.Count} con {myResult.HandName}";

            // El sonido no se decide aqui: este evento llega antes que el
            // estado terminado, y GameOver todavia es false. Con la partida
            // ganada sonaba la victoria de una ronda cualquiera.
            _sonidoPendiente = position == 1;
            SonidoDeFinDeRonda();
        }

        // Aqui no va el anuncio: taparia los resultados justo cuando el jugador
        // quiere ver quien ha ganado. Se pide al decidir (HandleContinue).
        InvokeAsync(StateHasChanged);
    }

    // Intersticial AdMob (solo surte efecto dentro de la app Android). Al salir
    // de la mesa se pide sin esperar: detras no corre ningun reloj.
    // Suena una vez por ronda revelada en directo (no al recargar en los
    // resultados): cuando se sabe como ha quedado el jugador (HandsRevealed) y
    // ha llegado el estado terminado, que es el que dice si la partida acabo.
    // Lo llaman los dos, porque no esta escrito cual llega antes.
    private bool? _sonidoPendiente;   // null: nada que sonar; true: gano la ronda; false: no

    private void SonidoDeFinDeRonda()
    {
        if (_sonidoPendiente is not bool gano || _state?.Status != GameStatus.Finished) return;
        _sonidoPendiente = null;
        if (gano && _state.GameOver) InvokeAsync(Audio.PlayChampion);
        else if (gano) InvokeAsync(Audio.PlayWinRound);
        else InvokeAsync(Audio.PlayLoseRound);
    }

    private async Task ShowInterstitialAd()
    {
        try { await JS.InvokeVoidAsync("TrikerAds.interstitial"); }
        catch { /* sin puente de anuncios (web normal) */ }
    }

    // Antes de pedir la ronda nueva: no vuelve hasta que el anuncio se cierra.
    // Si la ronda empezara con el anuncio delante, los 60 s del turno correrian
    // sin que el jugador vea sus cartas.
    //
    // Quien ve el anuncio todavia no ha enviado su decision. Si mientras tanto
    // otro jugador decide, empieza a correr el minuto de plazo: antes de que
    // venza se deja de esperar y se envia, aunque el anuncio siga delante. Es
    // peor empezar la ronda tapado que salir de la mesa por ver un anuncio.
    private static readonly TimeSpan MargenParaDecidir = TimeSpan.FromSeconds(8);

    private async Task ShowInterstitialAdAndWait()
    {
        try
        {
            var anuncio = JS.InvokeAsync<bool>("TrikerAds.interstitialAndWait").AsTask();
            while (!anuncio.IsCompleted && !PlazoApurado())
                await Task.WhenAny(anuncio, Task.Delay(500));
            if (anuncio.IsCompleted) await anuncio;
            else _ = anuncio.ContinueWith(t => _ = t.Exception, TaskContinuationOptions.OnlyOnFaulted);
        }
        catch { /* sin puente de anuncios (web normal) */ }
    }

    private bool PlazoApurado()
        => _state?.ContinueDeadline is { } plazo && plazo - DateTimeOffset.UtcNow < MargenParaDecidir;

    // Volver al lobby es subir un nivel, no avanzar: con replace, el lobby
    // sustituye a la partida en el historial en vez de apilarse encima. Sin
    // esto, "atras" desde el lobby volvia a meterte en la partida que acababas
    // de dejar (el boton de Android hace webView.goBack, ver MainActivity.kt).
    private void GoToLobby() => Nav.NavigateTo("", replace: true);

    // El lobby con esta partida elegida: si aun espera jugadores, entra.
    private void JoinFromLobby() => Nav.NavigateTo($"?join={GameId}", replace: true);

    private void OnAutoLeft()
    {
        if (_asiento != null) _ = Session.OlvidarAsiento(_asiento.GameId, _asiento.Id);
        InvokeAsync(() => Nav.NavigateTo("?aviso=fuera", replace: true));
    }

    // No se cierra solo: si el turno se agoto es porque el jugador no estaba
    // mirando, y un aviso que se desvanece es justo el que se pierde. Se quita
    // al empezar la ronda siguiente (ver el reparto en ApplyState).
    private void OnTurnTimedOut()
    {
        _turnTimedOut = true;
        InvokeAsync(StateHasChanged);
    }

    private async Task AddBot()
    {
        if (_asiento == null) return;
        _error = await Api.AddBot(_asiento) ? "" : "No se pudo añadir el bot";
    }

    private async Task StartGame()
    {
        if (_asiento == null) return;
        _error = await Api.StartGame(_asiento) ? "" : "No se pudo iniciar la partida";
    }

    private async Task HandleDiscard(List<Guid> cardIds)
    {
        if (_asiento == null) return;
        _discarded = true;
        _error = "";
        StopCountdown();
        var envio = await Api.Discard(_asiento, new() { CardIds = cardIds });
        if (envio == ResultadoEnvio.Ok) return;

        // Rechazado: el servidor recibio la jugada y no la acepto, casi
        // siempre porque el turno se agoto justo antes. Decia "comprueba la
        // conexion", que manda al jugador a mirar lo que no esta roto.
        _error = envio == ResultadoEnvio.Rechazado
            ? "El descarte no ha contado: tu turno ya había terminado."
            : "No se pudo enviar el descarte. Comprueba la conexión y vuelve a intentarlo.";
        _discarded = false;
        if (_state?.TurnDeadline is { } deadline) StartCountdown(deadline);
    }

    private async Task SendReaction(string emoji)
    {
        if (_asiento != null) await Api.SendReaction(_asiento, emoji);
    }

    private Task AskLeave()
    {
        _confirmLeave = true;
        return Task.CompletedTask;
    }

    // Salir de la mesa en cualquier momento (sala de espera o a mitad de
    // ronda). Con la ronda terminada se sale desde los resultados.
    private async Task LeaveGame()
    {
        if (_asiento == null || _leaving) return;
        _leaving = true;
        _error = "";
        if (await Api.Leave(_asiento))
        {
            await Session.OlvidarAsiento(_asiento.GameId, _asiento.Id);
            GoToLobby();
            return;
        }
        _leaving = false;
        _confirmLeave = false;
        _error = "No se pudo salir de la partida. Comprueba la conexión y vuelve a intentarlo.";
    }

    private async Task LeaveSpectate()
    {
        if (_asiento != null)
        {
            await Api.LeaveSpectate(_asiento);
            await Session.OlvidarAsiento(_asiento.GameId, _asiento.Id);
        }
        GoToLobby();
    }

    private void OnReaction(ChatReactionDto r)
    {
        var seq = ++_reactionSeq;
        _reactions[r.PlayerId] = new ReactionEntry(r.Emoji, seq);
        InvokeAsync(StateHasChanged);
        _ = ClearReactionAfter(r.PlayerId, seq);
    }

    private async Task ClearReactionAfter(Guid playerId, int seq)
    {
        await Task.Delay(ReactionTtl);
        if (_reactions.TryGetValue(playerId, out var current) && current.Seq == seq)
        {
            _reactions.Remove(playerId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleContinue(bool wantsToContinue)
    {
        if (IsSpectator)
        {
            await LeaveSpectate();
            return;
        }
        if (_asiento == null) return;
        _error = "";

        if (!wantsToContinue)
        {
            // La salida se envia ya, con el anuncio abriendose: los demas no
            // tienen por que esperar a que este jugador lo cierre.
            _ = ShowInterstitialAd();
            // Si falla, el temporizador de fin de ronda le saca igualmente.
            await Api.Continue(_asiento, new() { WantsToContinue = false });
            await Session.OlvidarAsiento(_asiento.GameId, _asiento.Id);
            GoToLobby();
            return;
        }

        _deciding = true;
        await ShowInterstitialAdAndWait();
        if (_asiento == null) return;
        if (!await Api.Continue(_asiento, new() { WantsToContinue = true }))
        {
            _deciding = false;
            _error = "No se pudo enviar tu decisión. Comprueba la conexión y vuelve a intentarlo.";
        }
    }

    private string GetApiBase()
        => Config["ApiBaseUrl"] ?? "https://localhost:7077";

    private static Guid? ParseGuidParamFromUrl(string url, string paramName)
    {
        var query = new Uri(url).Query.TrimStart('?');
        foreach (var part in query.Split('&'))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0] == paramName
                && Guid.TryParse(Uri.UnescapeDataString(kv[1]), out var id))
                return id;
        }
        return null;
    }

    public async ValueTask DisposeAsync()
    {
        StopCountdown();
        if (_subscribed)
        {
            Hub.OnChange -= OnHubChange;
            Hub.OnHandsRevealed -= OnHandsRevealed;
            Hub.OnAutoLeft -= OnAutoLeft;
            Hub.OnTurnTimedOut -= OnTurnTimedOut;
            Hub.OnReconnecting -= OnHubReconnecting;
            Hub.OnReconnected -= OnHubReconnected;
            Hub.OnConnectionClosed -= OnHubConnectionClosed;
            Hub.OnSeatLost -= OnSeatLost;
            Hub.OnReaction -= OnReaction;
        }
        await Hub.DisposeAsync();
    }
}
