<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" ya no impide la copia de un dispositivo
     a otro; hay que excluirlo aquí. Lo único que guarda la app es el
     localStorage del WebView, con los asientos (tokens) de las partidas. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
