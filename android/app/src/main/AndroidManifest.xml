<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Triker"
        android:usesCleartextTraffic="false">

        <!-- AdMob App ID: el de prueba de Google en debug y el real en release
             (src/debug y src/release, res/values/ads.xml). -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id" />

        <!-- Expone la imagen de la jugada (guardada en caché por ShareBridge)
             como content:// para que otras apps puedan leerla al compartir. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links: un enlace de invitación (https://<web>/?join=...)
                 abre la app si está instalada. Android lo comprueba contra
                 /.well-known/assetlinks.json de la web. Solo la raíz: el resto
                 de páginas (privacidad.html) siguen abriéndose en el navegador.
                 singleTask: con la app ya abierta el enlace llega a
                 onNewIntent en vez de crear una segunda pantalla.
                 El host es el de app_url (strings.xml): si cambia uno, el otro. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="triker-app.angelgf.com.es" />
                <data android:path="/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
