[Unit]
Description=Triker API
After=network.target postgresql.service

[Service]
User=webapps
WorkingDirectory=/apps/triker/api
ExecStart=/usr/bin/dotnet /apps/triker/api/Triker.Api.dll
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
Restart=always
RestartSec=10
KillSignal=SIGINT
SyslogIdentifier=triker-api

[Install]
WantedBy=multi-user.target
